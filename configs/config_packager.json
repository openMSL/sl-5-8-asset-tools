{
	"name": "packager",
	"environment type" : "python",
	"data folder" : "temp",
	"params" : 	{
		"call" : "packager.main",
		"input" : {"" : "{asset_path}/input_manifest.json"},
		"output" : {"-out" : "{path}/{sub_path}/{name}_structure.json"},
		"additional" : {
			"-path" : "{path}",
			"-asset_json" : "{path}/metadata/{asset_type}.json",
			"-asset_extractor" : "{path}/{sub_path}/{name}_extractor.json"
		}	
	}
}