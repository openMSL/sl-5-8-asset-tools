{
    "name": "metadata_enricher",
    "environment type": "python",
    "data folder": "metadata",
    "params": {
        "call": "metadata_enricher.main",
        "input": {
            "enrich": "{path}"
        },
        "output": {
            "--output-path": "{path}/{sub_path}/{asset_type}.json"
        },
        "additional": {
            "--asset-type": "{asset_type}",
            "--source-dir": "{asset_path}"
        }
    }
}
