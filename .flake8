[flake8]
max-line-length = 88
extend-ignore =
    # Black handles line length and whitespace
    E501,
    E203,
    W503,
    # Pre-existing violations (tighten incrementally):
    # F401 (34) — unused imports
    # F841 (17) — unused variables
    # F541 (16) — f-string without placeholders
    # E722 (15) — bare except
    F401,
    F841,
    F541,
    E722,
    E266,
    E712,
    E713,
    E721,
    F601,
    # F821 — undefined name (1 real bug in extract_osc.py:1611, pre-existing)
    F821,
per-file-ignores =
    __init__.py:F401
